extends ../layout

block content
  h1 Employees
  a.btn.btn-primary(href="/employees/new") + Add Employee

  form(action="/employees" method="GET")
    select(name="status")
      option(value="" selected=(query.status === undefined || query.status === '')) All
      option(value="active" selected=(query.status === 'active')) Active
      option(value="inactive" selected=(query.status === 'inactive')) Inactive
    input(type="text" name="search" placeholder="Search name or code" value=query.search)
    button(type="submit") Filter

  table#employeesTable.table 
    thead
      tr
        th Code
        th Name
        th Email
        th Department
        th Active 
        th Actions
    tbody
      each employee in employees
        tr
          td= employee.employeeCode
          td= employee.firstName + ' ' + employee.lastName
          td= employee.email
          td= employee.department
          td= employee.isActive ? 'Yes' : 'No'
          td
            a(href="/employees/" + employee.id + "/edit") Edit